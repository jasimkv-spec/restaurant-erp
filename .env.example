# PostgreSQL connection string (managed Postgres recommended for production)
DATABASE_URL="postgresql://erp_user:erp_password@localhost:5432/restaurant_erp?schema=public"

# App
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="8h"

# Tenant resolution: header | subdomain
TENANT_RESOLUTION_MODE=header
